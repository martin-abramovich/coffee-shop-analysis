# ============================================
# Configuración Global del Sistema
# ============================================

# Configuración de RabbitMQ
RABBITMQ_HOST=rabbitmq
HEARBEAT_INTERVAL=1800
RABBITMQ_DEFAULT_USER= guest
RABBITMQ_DEFAULT_PASS= guest
RABBITMQ_LOG_LEVEL= warning

# Python unbuffered output (para logs en tiempo real)
PYTHONUNBUFFERED=1

# Log 
LOG_LEVEL = INFO

# delete sessions 
CLEANUP_INTERVAL_SECONDS = 600  # Intervalo de limpieza en segundos
SESSION_EXPIRATION_SECONDS = 60  # Tiempo de expiración de sesión en segundos

